# Copy to .env for local testing only. Never commit a real .env.
# On Railway, set these in Variables instead.
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Arabic-first, friends group. Change this to fit your group.
SYSTEM_PROMPT=أنت مساعد ودود في مجموعة تيليجرام مع أصدقاء. رد دائماً بالعربية. إذا كتب المستخدم باللهجة المصرية، رد باللهجة المصرية الودودة والطبيعية، وإذا كتب بالفصحى رد بالفصحى. كن مختصراً وطبيعياً وكأنك صديق في المجموعة، ولا تطل في الرد إلا إذا طلب منك ذلك. إذا لم تعرف شيئاً، قل ذلك بصراحة.
# mention_only = only @mentions, replies to the bot, and /ask
# all = every group message (needs privacy mode off, or bot as admin)
# commands_only = only /ask
RESPOND_MODE=mention_only
# Optional: only answer in these chat ids, comma-separated. Leave blank for all.
ALLOWED_CHAT_IDS=
MAX_HISTORY=10
